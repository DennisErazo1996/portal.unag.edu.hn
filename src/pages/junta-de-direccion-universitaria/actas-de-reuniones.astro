---
export const prerender = true;

import Layout from '@/layouts/main.astro';
import HeaderPages from '@/components/astro/ui/header-bg-pages.astro';
import { actasJduOrdinarias, actasJduExtraordinarias } from '@/consts/actas-jdu';
import ArchivoCard from '@/components/astro/ui/archivo-card.astro';

const content = {
    title: 'Actas de Reuniones - JDU | UNAG'
}

const secciones = [
    { id: 'sesiones-ordinarias', titulo: 'Sesiones Ordinarias', actas: actasJduOrdinarias },
    { id: 'sesiones-extraordinarias', titulo: 'Sesiones Extraordinarias', actas: actasJduExtraordinarias },
];
---

<Layout content={content}>
    <HeaderPages
        imagen="/img/bg-default-unag.webp"
        etiqueta="JDU"
        titulo="Actas de Reuniones"
        descripcion="Las actas de reuniones de la Junta de Dirección Universitaria (JDU) son documentos oficiales que registran los temas discutidos, las decisiones tomadas y las acciones acordadas durante las reuniones."
    />

    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <div class="mb-12 max-w-7xl mx-auto">
            <p class="text-unag-dark-green dark:text-white mb-4 text-sm">Estas actas son fundamentales para mantener un registro transparente y accesible de las actividades y decisiones de la JDU, permitiendo a los miembros de la comunidad universitaria estar informados sobre los acuerdos y las iniciativas de la dirección universitaria.</p>
        </div>

        <div class="space-y-16">
            {secciones.map((seccion) => (
                <div id={seccion.id} class="space-y-6 scroll-mt-24">
                    <h2 class="text-2xl font-bold text-unag-dark-green dark:text-white">{seccion.titulo}</h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                        {seccion.actas.map((doc) => (
                            <ArchivoCard
                                titulo={doc.title}
                                fecha={doc.date}
                                archivo={doc.url}
                            />
                        ))}
                    </div>
                </div>
            ))}
        </div>
    </section>
</Layout>
