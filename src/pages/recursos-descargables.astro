---
export const prerender = true;

import Layout from '@/layouts/main.astro';
import HeaderPages from '@/components/astro/ui/header-bg-pages.astro';
import PlantillaCard from '@/components/astro/ui/plantilla-card.astro';
import { gruposPlantillas } from '@/consts/plantillas';

const content = {
    title: 'Recursos Descargables | UNAG'
}
---

<Layout content={content}>
    <HeaderPages
        imagen="/img/bg-default-unag.webp"
        etiqueta="UNAG"
        titulo="Recursos Descargables"
        descripcion="Descarga materiales de apoyo, presentaciones y recursos académicos diseñados para enriquecer tu experiencia institucional."
    />

    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <div class="mb-12 text-center max-w-3xl mx-auto">
            <h2 class="text-3xl font-bold text-unag-dark-green mb-4">Plantillas Institucionales</h2>
            <p class="text-gray-500 dark:text-white">
                Logos, portadas, diplomas y presentaciones oficiales de la UNAG, listos para descargar y usar.
            </p>
        </div>

        <!-- Tab Navigation -->
        <div class="mb-8">
            <!-- Mobile: Select dropdown -->
            <div class="sm:hidden">
                <select
                    id="tab-select"
                    class="w-full px-4 py-3 bg-white border border-gray-300 rounded-lg text-sm font-medium text-gray-700 focus:outline-none focus:ring-2 focus:ring-unag-green focus:border-transparent"
                >
                    {gruposPlantillas.map((grupo) => (
                        <option value={grupo.id}>{grupo.nombre}</option>
                    ))}
                </select>
            </div>

            <!-- Desktop: Tabs -->
            <div class="hidden sm:block border-b border-gray-200">
                <nav class="-mb-px flex space-x-8" aria-label="Tabs">
                    {gruposPlantillas.map((grupo) => (
                        <button
                            class="tab-button border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm transition-colors"
                            data-tab={grupo.id}
                        >
                            {grupo.nombre}
                        </button>
                    ))}
                </nav>
            </div>
        </div>

        <!-- Tab Content -->
        <div class="tab-content-container">
            {gruposPlantillas.map((grupo) => {
                const horizontales = grupo.items.filter((item) => item.orientacion === 'horizontal');
                const verticales = grupo.items.filter((item) => item.orientacion === 'vertical');
                const sinOrientacion = grupo.items.filter((item) => !item.orientacion);

                return (
                    <div class="tab-content" data-tab-content={grupo.id}>
                        <p class="text-sm text-gray-500 dark:text-white mb-6">{grupo.descripcion}</p>

                        {horizontales.length > 0 && (
                            <div class="mb-8">
                                <h3 class="text-base font-semibold text-unag-dark-green mb-4">Horizontal</h3>
                                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                                    {horizontales.map((item) => (
                                        <PlantillaCard {...item} />
                                    ))}
                                </div>
                            </div>
                        )}

                        {verticales.length > 0 && (
                            <div class="mb-8">
                                <h3 class="text-base font-semibold text-unag-dark-green mb-4">Vertical</h3>
                                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                                    {verticales.map((item) => (
                                        <PlantillaCard {...item} />
                                    ))}
                                </div>
                            </div>
                        )}

                        {sinOrientacion.length > 0 && (
                            <div class="mb-8">
                                <h3 class="text-base font-semibold text-unag-dark-green mb-4">Sin orientación definida</h3>
                                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                                    {sinOrientacion.map((item) => (
                                        <PlantillaCard {...item} />
                                    ))}
                                </div>
                            </div>
                        )}
                    </div>
                );
            })}
        </div>
    </section>
</Layout>

<script>
    // Tab functionality
    document.addEventListener("DOMContentLoaded", () => {
        const tabButtons = document.querySelectorAll(".tab-button");
        const tabContents = document.querySelectorAll(".tab-content");
        const tabSelect = document.getElementById("tab-select") as HTMLSelectElement;

        const switchTab = (tabName: string, updateHash = true) => {
            tabButtons.forEach((btn) => {
                btn.classList.remove("border-unag-green", "text-unag-green");
                btn.classList.add("border-transparent", "text-gray-500");
            });

            const activeButton = document.querySelector(`[data-tab="${tabName}"]`);
            if (activeButton) {
                activeButton.classList.add("border-unag-green", "text-unag-green");
                activeButton.classList.remove("border-transparent", "text-gray-500");
            }

            tabContents.forEach((content) => {
                content.classList.add("hidden");
            });

            const selectedContent = document.querySelector(`[data-tab-content="${tabName}"]`);
            if (selectedContent) {
                selectedContent.classList.remove("hidden");
            }

            if (tabSelect) {
                tabSelect.value = tabName;
            }

            if (updateHash) {
                history.replaceState(null, "", `#${tabName}`);
            }
        };

        tabButtons.forEach((button) => {
            button.addEventListener("click", () => {
                const tabName = button.getAttribute("data-tab");
                if (tabName) switchTab(tabName);
            });
        });

        tabSelect?.addEventListener("change", () => {
            switchTab(tabSelect.value);
        });

        const initialTab = location.hash.replace("#", "");
        const validTab = initialTab && document.querySelector(`[data-tab="${initialTab}"]`);
        if (tabButtons.length > 0) {
            switchTab(validTab ? initialTab : "logos", false);
        }
    });
</script>
